# Copy this file to .env and fill in the values you need.

# --- LLM providers (diagnosis, planning, and the classifier's fallback path) ---
# At least one of these is required. Precedence: OPENAI_API_KEY, else GROQ_API_KEY
# (see the model: ternary in each src/agents/*.ts). GOOGLE_GENERATIVE_AI_API_KEY
# is kept for reference but is no longer used for primary model selection —
# Gemini's free-tier quota (20 req/day) made it unreliable for this workload.
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Local fallback model used by generateWithFailover() when both primary
# providers are unavailable (src/models/fallback.ts). Optional.
OLLAMA_BASE_URL=

# --- TypeSafe / Jev (fast incident classification) ---
# Powers the classify step's Choice-based triage (src/services/jev-client.ts).
# When unset, the workflow falls back to the LLM-based classifier agent.
TYPESAFE_API_KEY=

# --- Vector memory (Qdrant) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Observability (SigNoz) ---
SIGNOZ_URL=
SIGNOZ_API_KEY=

# --- AI safety gate (Enkrypt) ---
ENKRYPT_API_KEY=
ENKRYPT_BASE_URL=

# --- AegisSRE SDK auth ---
AEGIS_API_KEY=

# --- Aegis-Firewall (JevGuard) command gate ---
# Screens every runbook shell command for genuinely dangerous operations
# (credential access, secrets pushed to GitHub, destructive deletes) before
# it runs — see src/services/firewall-client.ts and src/runbooks/local-executor.ts.
# When unset, commands run unchecked (fail-open).
AEGIS_FIREWALL_MCP_PATH=
AEGIS_FIREWALL_PYTHON=
